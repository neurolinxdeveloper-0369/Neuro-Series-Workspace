# Server Port & Environment
NODE_ENV=production
PORT=3056

# Database (PostgreSQL)
DATABASE_URL=postgresql://neurolinx_admin:NeuroSeriesSecure2026!@smart-workspace-db:5432/neurolinx_smart_workspace

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d

# Google OAuth 2.0 Client IDs
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com

# EMQX MQTT Broker Configuration (Host port: 1887, Internal Docker: 1883)
MQTT_BROKER_URL=mqtt://smart-workspace-emqx:1883
MQTT_CLIENT_ID=neuro-series-server-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=neurolinx/devices
