# Server Port & Environment
NODE_ENV=production
PORT=3056

# Database (PostgreSQL)
DATABASE_URL=postgresql://neurolinx_admin:replace_me@localhost:5439/neurolinx_smart_workspace

# JWT Authentication Secret
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
JWT_EXPIRES_IN=30d

# Google OAuth 2.0 Client IDs
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com

# EMQX MQTT Broker Configuration (Host port: 1887, Internal Docker: 1883)
MQTT_BROKER_URL=mqtt://smart-workspace-emqx:1883
MQTT_CLIENT_ID=neuro-series-server-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_DEVICE_USERNAME=
MQTT_DEVICE_PASSWORD=
MQTT_USE_LEGACY_COMMAND_TOPICS=false
MQTT_TOPIC_PREFIX=neurolinx/devices

# OpenWA WhatsApp Gateway Configuration
OPENWA_BASE_URL=http://50.6.45.177:2785/api
OPENWA_API_KEY=
OPENWA_SESSION_NAME=neuro-touch
OPENWA_SESSION_ID=40f62065-9a8e-4f77-8120-7f3bd73f50ea
